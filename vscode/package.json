{
  "name": "mapcan",
  "displayName": "mapcan",
  "description": "CAN signal maps as code: validation, hovers with frame bit layouts and computed CAN IDs for mapcan YAML files.",
  "version": "0.1.0",
  "publisher": "ordu1453",
  "private": true,
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0065A9",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ordu1453/mapcan"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "CAN",
    "CANopen",
    "J1939",
    "DBC",
    "YAML"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mapcan",
          "title": "mapcan",
          "icon": "media/mapcan.svg"
        }
      ]
    },
    "views": {
      "mapcan": [
        {
          "id": "mapcan.map",
          "name": "Map",
          "icon": "media/mapcan.svg"
        },
        {
          "id": "mapcan.form",
          "type": "webview",
          "name": "Node",
          "icon": "media/mapcan.svg",
          "when": "mapcan.formOpen"
        },
        {
          "id": "mapcan.export",
          "type": "webview",
          "name": "Export",
          "icon": "media/mapcan.svg",
          "when": "mapcan.mapOpen"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mapcan.map",
        "contents": "[Open Map](command:mapcan.openMap)",
        "when": "!mapcan.mapOpen"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mapcan.addBus",
          "when": "view == mapcan.map && mapcan.mapOpen",
          "group": "navigation@0"
        },
        {
          "command": "mapcan.openPreview",
          "when": "view == mapcan.map && mapcan.mapOpen",
          "group": "navigation@1"
        },
        {
          "command": "mapcan.compareWithRevision",
          "when": "view == mapcan.map && mapcan.mapOpen",
          "group": "1_map@1"
        },
        {
          "command": "mapcan.revealFormNode",
          "when": "view == mapcan.form",
          "group": "navigation@0"
        },
        {
          "command": "mapcan.closeForm",
          "when": "view == mapcan.form",
          "group": "navigation@1"
        }
      ],
      "commandPalette": [
        {
          "command": "mapcan.export",
          "when": "mapcan.mapOpen"
        },
        {
          "command": "mapcan.addBus",
          "when": "mapcan.mapOpen"
        },
        {
          "command": "mapcan.addDevice",
          "when": "false"
        },
        {
          "command": "mapcan.addFrame",
          "when": "false"
        },
        {
          "command": "mapcan.addSignal",
          "when": "false"
        },
        {
          "command": "mapcan.renameNode",
          "when": "false"
        },
        {
          "command": "mapcan.duplicateNode",
          "when": "false"
        },
        {
          "command": "mapcan.deleteNode",
          "when": "false"
        },
        {
          "command": "mapcan.openPreview",
          "when": "mapcan.mapOpen"
        },
        {
          "command": "mapcan.compareWithRevision",
          "when": "mapcan.mapOpen"
        },
        {
          "command": "mapcan.editNode",
          "when": "false"
        },
        {
          "command": "mapcan.closeForm",
          "when": "false"
        },
        {
          "command": "mapcan.revealFormNode",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "mapcan.addDevice",
          "when": "view == mapcan.map && viewItem == bus",
          "group": "inline@1"
        },
        {
          "command": "mapcan.addFrame",
          "when": "view == mapcan.map && viewItem == device",
          "group": "inline@1"
        },
        {
          "command": "mapcan.addSignal",
          "when": "view == mapcan.map && viewItem == frame",
          "group": "inline@1"
        },
        {
          "command": "mapcan.editNode",
          "when": "view == mapcan.map && viewItem =~ /^(bus|device|frame|signal|flag|sdo)$/",
          "group": "inline@2"
        },
        {
          "command": "mapcan.addDevice",
          "when": "view == mapcan.map && viewItem == bus",
          "group": "1_add@1"
        },
        {
          "command": "mapcan.addFrame",
          "when": "view == mapcan.map && viewItem =~ /^(bus|device)$/",
          "group": "1_add@2"
        },
        {
          "command": "mapcan.addSignal",
          "when": "view == mapcan.map && viewItem == frame",
          "group": "1_add@3"
        },
        {
          "command": "mapcan.editNode",
          "when": "view == mapcan.map && viewItem =~ /^(bus|device|frame|signal|flag|sdo)$/",
          "group": "2_edit@0"
        },
        {
          "command": "mapcan.renameNode",
          "when": "view == mapcan.map && viewItem =~ /^(bus|device|frame|signal|flag|sdo)$/",
          "group": "2_edit@1"
        },
        {
          "command": "mapcan.duplicateNode",
          "when": "view == mapcan.map && viewItem =~ /^(device|frame|signal|flag|sdo)$/",
          "group": "2_edit@2"
        },
        {
          "command": "mapcan.deleteNode",
          "when": "view == mapcan.map && viewItem =~ /^(bus|device|frame|signal|flag|sdo)$/",
          "group": "3_delete@1"
        }
      ]
    },
    "commands": [
      {
        "command": "mapcan.export",
        "title": "Export",
        "category": "mapcan",
        "icon": "$(export)"
      },
      {
        "command": "mapcan.openMap",
        "title": "Open Map…",
        "category": "mapcan",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mapcan.revealNode",
        "title": "Reveal in Editor",
        "category": "mapcan"
      },
      {
        "command": "mapcan.restartServer",
        "title": "Restart Language Server",
        "category": "mapcan"
      },
      {
        "command": "mapcan.showOutput",
        "title": "Show Language Server Output",
        "category": "mapcan"
      },
      {
        "command": "mapcan.openPreview",
        "title": "Open Document Preview",
        "category": "mapcan",
        "icon": "$(open-preview)"
      },
      {
        "command": "mapcan.compareWithRevision",
        "title": "Compare with Revision…",
        "category": "mapcan",
        "icon": "$(git-compare)"
      },
      {
        "command": "mapcan.addBus",
        "title": "Add Bus",
        "category": "mapcan",
        "icon": "$(add)"
      },
      {
        "command": "mapcan.addDevice",
        "title": "Add Device",
        "category": "mapcan",
        "icon": "$(add)"
      },
      {
        "command": "mapcan.addFrame",
        "title": "Add Frame",
        "category": "mapcan",
        "icon": "$(add)"
      },
      {
        "command": "mapcan.addSignal",
        "title": "Add Signal",
        "category": "mapcan",
        "icon": "$(add)"
      },
      {
        "command": "mapcan.editNode",
        "title": "Edit…",
        "category": "mapcan",
        "icon": "$(edit)"
      },
      {
        "command": "mapcan.renameNode",
        "title": "Rename…",
        "category": "mapcan"
      },
      {
        "command": "mapcan.duplicateNode",
        "title": "Duplicate",
        "category": "mapcan"
      },
      {
        "command": "mapcan.deleteNode",
        "title": "Delete",
        "category": "mapcan",
        "icon": "$(trash)"
      },
      {
        "command": "mapcan.closeForm",
        "title": "Close",
        "category": "mapcan",
        "icon": "$(close)"
      },
      {
        "command": "mapcan.revealFormNode",
        "title": "Show in Editor",
        "category": "mapcan",
        "icon": "$(go-to-file)"
      }
    ],
    "configuration": {
      "title": "mapcan",
      "properties": {
        "mapcan.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `mapcan` executable that runs the language server. Empty means `mapcan` from `PATH`. Requires `mapcan[lsp]`.",
          "scope": "machine-overridable"
        },
        "mapcan.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the mapcan executable.",
          "scope": "machine-overridable"
        },
        "mapcan.export.outputDir": {
          "type": "string",
          "default": "build",
          "markdownDescription": "Folder for the **Export** panel's results, relative to the map's folder (absolute paths also work). A folder chosen in the panel takes precedence for that map.",
          "scope": "resource"
        }
      }
    },
    "keybindings": [
      {
        "command": "mapcan.renameNode",
        "key": "f2",
        "when": "focusedView == mapcan.map"
      },
      {
        "command": "mapcan.deleteNode",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == mapcan.map"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "test": "npm run build && node test/runTest.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0"
  }
}
