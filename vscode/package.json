{
  "name": "mapcan",
  "displayName": "mapcan",
  "description": "CAN signal maps as code: validation, a Map view with forms and frame bit layouts, hovers, rename, export and history for mapcan YAML files.",
  "version": "0.6.6",
  "publisher": "ordu1453",
  "private": true,
  "preview": true,
  "license": "Apache-2.0",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0065A9",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ordu1453/mapcan"
  },
  "homepage": "https://github.com/ordu1453/mapcan/tree/main/vscode#readme",
  "bugs": {
    "url": "https://github.com/ordu1453/mapcan/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "CAN",
    "CANopen",
    "J1939",
    "DBC",
    "YAML"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the language server is started and the export folder is taken from the user's settings only, not from the workspace's.",
      "restrictedConfigurations": [
        "mapcan.server.path",
        "mapcan.server.args",
        "mapcan.export.outputDir"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The language server reads the maps and the files they include from the disk."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mapcan",
          "title": "mapcan",
          "icon": "media/mapcan.svg"
        }
      ]
    },
    "views": {
      "mapcan": [
        {
          "id": "mapcan.map",
          "name": "Map",
          "icon": "media/mapcan.svg"
        },
        {
          "id": "mapcan.form",
          "type": "webview",
          "name": "Node",
          "icon": "media/mapcan.svg",
          "when": "mapcan.formOpen"
        },
        {
          "id": "mapcan.export",
          "type": "webview",
          "name": "Export",
          "icon": "media/mapcan.svg",
          "when": "mapcan.mapOpen"
        },
        {
          "id": "mapcan.history",
          "name": "History",
          "icon": "media/mapcan.svg",
          "when": "mapcan.mapOpen"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "mapcan.start",
        "title": "Get started with mapcan",
        "description": "CAN signal maps as code: check, edit and export them in VS Code.",
        "steps": [
          {
            "id": "install",
            "title": "Install mapcan",
            "description": "The extension runs on the mapcan tool. One click installs it, Python included, for every folder.\n[Install mapcan](command:mapcan.installServer)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:mapcan.serverRunning",
              "onCommand:mapcan.installServer"
            ]
          },
          {
            "id": "example",
            "title": "Open an example",
            "description": "An electric vehicle, a CANopen drive, a J1939 ECU or a map in several files, copied to a folder you choose.\n[Open Example](command:mapcan.openExample)",
            "media": {
              "image": {
                "light": "media/walkthrough/map-light.jpg",
                "dark": "media/walkthrough/map-dark.jpg",
                "hc": "media/walkthrough/map-dark.jpg"
              },
              "altText": "The Node panel of a frame with its bit layout next to the map's YAML"
            },
            "completionEvents": [
              "onCommand:mapcan.openExample"
            ]
          },
          {
            "id": "mapview",
            "title": "Edit in the Map view",
            "description": "Buses, devices, frames and signals as a tree. The pencil opens a node's fields and the frame's bit layout; every change is written to the YAML.\n[Show the Map View](command:workbench.view.extension.mapcan)",
            "media": {
              "image": {
                "light": "media/walkthrough/map-light.jpg",
                "dark": "media/walkthrough/map-dark.jpg",
                "hc": "media/walkthrough/map-dark.jpg"
              },
              "altText": "The Node panel of a frame with its bit layout next to the map's YAML"
            },
            "completionEvents": [
              "onView:mapcan.map"
            ]
          },
          {
            "id": "problems",
            "title": "Catch mistakes as you type",
            "description": "Every change is checked. Ctrl+. fixes most problems in place.\n[Show a Problem](command:mapcan.tour.showProblem)",
            "media": {
              "image": {
                "light": "media/walkthrough/problems-light.jpg",
                "dark": "media/walkthrough/problems-dark.jpg",
                "hc": "media/walkthrough/problems-dark.jpg"
              },
              "altText": "Two overlapping signals marked in the tree and the editor, with the quick fix that moves one to free bits"
            },
            "completionEvents": [
              "onCommand:mapcan.tour.showProblem"
            ]
          },
          {
            "id": "hover",
            "title": "See a frame at a glance",
            "description": "Hover a frame for its CAN ID, timing, receivers and bit layout.\n[Show a Hover](command:mapcan.tour.showHover)",
            "media": {
              "image": {
                "light": "media/walkthrough/hover-light.jpg",
                "dark": "media/walkthrough/hover-dark.jpg",
                "hc": "media/walkthrough/hover-dark.jpg"
              },
              "altText": "The hover of a frame with its ID, timing, receivers and bit layout"
            },
            "completionEvents": [
              "onCommand:mapcan.tour.showHover"
            ]
          },
          {
            "id": "export",
            "title": "Export",
            "description": "DBC, C and Python code, Excel, PDF, Markdown and HTML from one map.\n[Open Export](command:mapcan.export)",
            "media": {
              "image": {
                "light": "media/walkthrough/export-light.jpg",
                "dark": "media/walkthrough/export-dark.jpg",
                "hc": "media/walkthrough/export-dark.jpg"
              },
              "altText": "The Export panel with the formats chosen and the files it wrote"
            },
            "completionEvents": [
              "onCommand:mapcan.export"
            ]
          },
          {
            "id": "history",
            "title": "Track versions",
            "description": "What each commit changed in frames and signals. Compare any two versions; release one with a tag and a revision history entry.\n[Show History](command:mapcan.tour.showHistory)",
            "media": {
              "image": {
                "light": "media/walkthrough/history-light.jpg",
                "dark": "media/walkthrough/history-dark.jpg",
                "hc": "media/walkthrough/history-dark.jpg"
              },
              "altText": "The History panel with the map's commits and the changes of one of them"
            },
            "completionEvents": [
              "onCommand:mapcan.tour.showHistory"
            ]
          },
          {
            "id": "create",
            "title": "Create your own map",
            "description": "Start from CANopen, SAE J1939, CAN with explicit IDs or an empty map.\n[Create Map](command:mapcan.newMap)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:mapcan.newMap"
            ]
          },
          {
            "id": "learn",
            "title": "Learn more",
            "description": "The format, the command line and the web editor are on GitHub.\n[Open on GitHub](https://github.com/ordu1453/mapcan)",
            "media": {
              "markdown": "media/walkthrough/learn.md"
            },
            "completionEvents": [
              "onLink:https://github.com/ordu1453/mapcan"
            ]
          }
        ]
      }
    ],
    "viewsWelcome": [
      {
        "view": "mapcan.map",
        "contents": "[Create Map](command:mapcan.newMap)\nOr open [an example](command:mapcan.openExample) or [a map you have](command:mapcan.openMap).",
        "when": "!mapcan.mapOpen"
      },
      {
        "view": "mapcan.history",
        "contents": "The map is not in a Git repository.\n[Initialize Repository](command:git.init)",
        "when": "mapcan.historyState == noRepo"
      },
      {
        "view": "mapcan.history",
        "contents": "No commits for this map yet.\n[Commit Map](command:mapcan.history.commit)",
        "when": "mapcan.historyState == noCommits"
      },
      {
        "view": "mapcan.history",
        "contents": "Git is not installed or not on PATH.\n[Download Git](https://git-scm.com/downloads)",
        "when": "mapcan.historyState == noGit"
      },
      {
        "view": "mapcan.history",
        "contents": "Save the map to track its history.",
        "when": "mapcan.historyState == unsaved"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mapcan.addBus",
          "when": "view == mapcan.map && mapcan.mapOpen",
          "group": "navigation@0"
        },
        {
          "command": "mapcan.openRepository",
          "when": "view == mapcan.map",
          "group": "9_links@1"
        },
        {
          "command": "mapcan.reportIssue",
          "when": "view == mapcan.map",
          "group": "9_links@2"
        },
        {
          "command": "mapcan.openPreview",
          "when": "view == mapcan.map && mapcan.mapOpen",
          "group": "navigation@1"
        },
        {
          "command": "mapcan.revealFormNode",
          "when": "view == mapcan.form",
          "group": "navigation@0"
        },
        {
          "command": "mapcan.closeForm",
          "when": "view == mapcan.form",
          "group": "navigation@1"
        },
        {
          "command": "mapcan.history.commit",
          "when": "view == mapcan.history && (mapcan.historyChanges || mapcan.historyState == noCommits)",
          "group": "navigation@0"
        },
        {
          "command": "mapcan.history.addToHistory",
          "when": "view == mapcan.history && mapcan.historyState == ok",
          "group": "navigation@1"
        },
        {
          "command": "mapcan.history.release",
          "when": "view == mapcan.history && (mapcan.historyState == ok || mapcan.historyState == noCommits)",
          "group": "navigation@2"
        },
        {
          "command": "mapcan.history.refresh",
          "when": "view == mapcan.history",
          "group": "navigation@3"
        }
      ],
