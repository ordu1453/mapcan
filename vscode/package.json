{
  "name": "mapcan",
  "displayName": "mapcan",
  "description": "CAN signal maps as code: validation, hovers with frame bit layouts and computed CAN IDs for mapcan YAML files.",
  "version": "0.1.0",
  "publisher": "ordu1453",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/ordu1453/mapcan"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "keywords": [
    "CAN",
    "CANopen",
    "J1939",
    "DBC",
    "YAML"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mapcan",
          "title": "mapcan",
          "icon": "media/mapcan.svg"
        }
      ]
    },
    "views": {
      "mapcan": [
        {
          "id": "mapcan.map",
          "name": "Map",
          "icon": "media/mapcan.svg",
          "contextualTitle": "mapcan"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mapcan.map",
        "contents": "Open a mapcan map (a YAML file with a top-level `mapcan: 1` key) to see its buses, devices, frames and signals.",
        "when": "!mapcan.mapOpen"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mapcan.export",
          "when": "view == mapcan.map && mapcan.mapOpen",
          "group": "navigation@1"
        },
        {
          "command": "mapcan.refreshMap",
          "when": "view == mapcan.map",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "mapcan.revealNode",
          "when": "false"
        },
        {
          "command": "mapcan.refreshMap",
          "when": "false"
        },
        {
          "command": "mapcan.export",
          "when": "mapcan.mapOpen"
        }
      ]
    },
    "commands": [
      {
        "command": "mapcan.export",
        "title": "Export…",
        "category": "mapcan",
        "icon": "$(export)"
      },
      {
        "command": "mapcan.refreshMap",
        "title": "Refresh",
        "category": "mapcan",
        "icon": "$(refresh)"
      },
      {
        "command": "mapcan.revealNode",
        "title": "Reveal in Editor",
        "category": "mapcan"
      },
      {
        "command": "mapcan.restartServer",
        "title": "Restart Language Server",
        "category": "mapcan"
      },
      {
        "command": "mapcan.showOutput",
        "title": "Show Language Server Output",
        "category": "mapcan"
      }
    ],
    "configuration": {
      "title": "mapcan",
      "properties": {
        "mapcan.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `mapcan` executable that runs the language server. Empty means `mapcan` from `PATH`. Requires `mapcan[lsp]`.",
          "scope": "machine-overridable"
        },
        "mapcan.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the mapcan executable.",
          "scope": "machine-overridable"
        },
        "mapcan.export.outputDir": {
          "type": "string",
          "default": "build",
          "markdownDescription": "Folder for **mapcan: Export…** results, relative to the map's folder (absolute paths also work).",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "test": "npm run build && node test/runTest.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0"
  }
}
