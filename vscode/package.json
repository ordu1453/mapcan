        "command": "mapcan.revealFormNode",
        "title": "Show in Editor",
        "category": "mapcan",
        "icon": "$(go-to-file)"
      }
    ],
    "configuration": {
      "title": "mapcan",
      "properties": {
        "mapcan.server.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `mapcan` executable that runs the language server. Empty means `mapcan` from the Python environment selected in the Python extension, if it has one, else the one the extension installed (**mapcan: Install or Update mapcan**), else from `PATH`. Requires `mapcan[lsp]` 0.21 or newer.",
          "scope": "machine-overridable"
        },
        "mapcan.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "lsp"
          ],
          "description": "Arguments passed to the mapcan executable.",
          "scope": "machine-overridable"
        },
        "mapcan.server.checkForUpdates": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Once a session of VS Code, look on PyPI for a newer mapcan than the one the extension installed, and offer to update it. A `mapcan` of your own is never checked.",
          "scope": "application"
        },
        "mapcan.export.outputDir": {
          "type": "string",
          "default": "build",
          "markdownDescription": "Folder for the **Export** panel's results, relative to the map's folder (absolute paths also work). A folder chosen in the panel takes precedence for that map.",
          "scope": "resource"
        },
        "mapcan.tree.showChanges": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Mark nodes of the **Map** view added or modified since the last commit, as Source Control marks files (A, M). Unsaved edits count too.",
          "scope": "resource"
        }
      }
    },
    "keybindings": [
      {
        "command": "mapcan.renameNode",
        "key": "f2",
        "when": "focusedView == mapcan.map"
      },
      {
        "command": "mapcan.deleteNode",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == mapcan.map"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p webview",
    "package": "vsce package --no-dependencies",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "test": "npm run build && node test/runTest.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.91.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "playwright-core": "^1.56.1",
    "typescript": "~5.9.0"
  }
}
