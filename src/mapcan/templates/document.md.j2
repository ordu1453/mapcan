<tr><th>{{ row.byte }}</th>{% for seg in row.segments %}<td colspan="{{ seg.span }}" align="center">{% if seg.conflict %}⚠ {% endif %}{{ seg.label or "·" }}</td>{% endfor %}</tr>
{%- endfor %}
</table>
