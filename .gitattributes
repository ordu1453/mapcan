# Текстовые файлы — с LF и в репозитории, и в рабочей копии, на любой ОС: без предупреждений
# «LF will be replaced by CRLF» при core.autocrlf=true и без смешанных концов строк в коммитах
* text=auto eol=lf

# Сценарий установщика Inno Setup — в привычных для Windows CRLF
*.iss text eol=crlf

# Двоичные файлы
*.png binary
*.ico binary
*.ttf binary
*.woff2 binary

# Собранный фронтенд всегда с LF, как его выдаёт сборка на CI (vite пишет смешанные концы строк)
src/mapcan/web/static/** text eol=lf
web/index.html text eol=lf
