# Text files with LF both in the repository and in the working copy on any OS: no
# "LF will be replaced by CRLF" warnings with core.autocrlf=true and no mixed line endings in commits
* text=auto eol=lf

# The Inno Setup installer script in the usual Windows CRLF
*.iss text eol=crlf

# Binary files
*.png binary
*.ico binary
*.ttf binary
*.woff2 binary

# The built frontend always with LF, as the CI build produces it (vite writes mixed line endings)
src/mapcan/web/static/** text eol=lf
web/index.html text eol=lf
