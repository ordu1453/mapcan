            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        }
      },
      "title": "Person",
      "type": "object"
    },
    "SdoExchange": {
      "additionalProperties": false,
      "description": "One SDO transfer (expedited): command, index, subindex, value.",
      "properties": {
        "name": {
          "description": "SDO exchange identifier: Latin letters, digits and _. Used in generated code. Required.",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "command": {
          "description": "SDO command byte (CCS/SCS), e.g. 0x2B — write 2 bytes, 0x23 — write 4 bytes, 0x40 — read.",
          "maximum": 255,
          "minimum": 0,
          "title": "Command",
          "type": "integer"
        },
        "index": {
          "description": "CANopen object dictionary index, 0x0000..0xFFFF.",
          "maximum": 65535,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "subindex": {
          "default": 0,
          "description": "Object dictionary subindex, 0x00..0xFF.",
          "maximum": 255,
          "minimum": 0,
          "title": "Subindex",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdoValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
