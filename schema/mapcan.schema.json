{
  "$defs": {
    "Bus": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Bus identifier: Latin letters, digits and _, no spaces. Used in DBC and C file names and as an anchor in documents. Required.",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable bus name, e.g. “Bus 1” or “Powertrain CAN”. Used as the section heading in documents and as the bus label in the map tree. Required.",
          "title": "Title"
        },
        "interface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Physical interface or connector, e.g. “CAN1, X3”. Used in documents only.",
          "title": "Interface"
        },
        "bitrate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bus bitrate in bit/s, e.g. 250000 or 500000. Shown in documents and DBC.",
          "title": "Bitrate"
        },
        "protocol": {
          "description": "Higher-layer protocol. CANopen: the frame ID is computed from the frame type and node_id; SAE J1939: from PGN, priority and the device address; CAN: each frame has an explicit ID.",
          "enum": [
            "canopen",
            "j1939",
            "can"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "fd": {
          "default": false,
          "description": "CAN FD bus: frames up to 64 bytes (DLC 0..8, 12, 16, 20, 24, 32, 48, 64).",
          "title": "Fd",
          "type": "boolean"
        },
        "brs": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Default bit rate switch (BRS) of CAN FD frames: the data field is sent at the data phase bit rate. Turn it off if the nodes or the wiring of the bus cannot handle the higher rate. A frame can set its own value.",
          "title": "Brs"
        },
        "data_bitrate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CAN FD: bit rate of the data phase in bit/s, e.g. 2000000. Frames with the bit rate switch (BRS) send their data field at this rate; it is used in the bus load estimate and shown in documents.",
          "title": "Data Bitrate"
        },
        "sample_point": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sample point of the (nominal) bit rate, percent of the bit time, e.g. 87.5. All nodes of a bus should use the same one. Shown in documents.",
          "title": "Sample Point"
        },
        "data_sample_point": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 50,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CAN FD: sample point of the data phase, percent, e.g. 75. Shown in documents.",
          "title": "Data Sample Point"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "frames": {
          "description": "Broadcast frames without an owning device (NMT, SYNC, TIME).",
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "title": "Frames",
          "type": "array"
        },
        "devices": {
          "items": {
            "$ref": "#/$defs/Device"
          },
          "title": "Devices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "protocol"
      ],
      "title": "Bus",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Device identifier: Latin letters, digits and _. Used in generated code, DBC, and frame senders and receivers. Required.",
          "title": "Name",
          "type": "string"
        },
        "short": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Short device abbreviation for tables and headings in documents, e.g. BMS. If set, the map tree shows it before the full name. If empty, documents use the identifier in uppercase.",
          "title": "Short"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Full human-readable device name, e.g. “Battery management system”. Shown in the device section heading in documents and in the map tree. Required.",
          "title": "Title"
        },
        "node_id": {
          "anyOf": [
            {
              "maximum": 127,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CANopen node address 1..127 (0x01..0x7F). Added to the base ID of PDO, SDO, EMCY and Heartbeat frames.",
          "title": "Node Id"
        },
        "address": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "J1939 source address 0..253 (0x00..0xFD). Forms the low byte of every frame ID the device sends; 254 and 255 are reserved.",
          "title": "Address"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "title": "Frames",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Device",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            }
          ],
          "title": "Title"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "version": {
          "default": "0.1",
          "title": "Version",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization"
        },
        "language": {
          "description": "Default document language: ISO 639-1 code (ru, en, de…).",
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        },
        "bit_numbering": {
          "const": "lsb0",
          "default": "lsb0",
          "description": "Bit numbering: lsb0 — bit 0 is the least significant bit of byte 0. The field states the convention explicitly and is shown in every document.",
          "title": "Bit Numbering",
          "type": "string"
        },
        "logo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company logo: path to a PNG/JPG/SVG relative to the map file.",
          "title": "Logo"
        },
        "designation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document designation, e.g. \"АБВГ.468332.001 Д1\" (ESKD).",
          "title": "Designation"
        },
        "litera": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document letter (ESKD), e.g. \"О1\".",
          "title": "Litera"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City for the title page.",
          "title": "City"
        },
        "signatures": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signatures"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approve": {
          "anyOf": [
            {
              "$ref": "#/$defs/Person"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The \"APPROVED\" block of the title page."
        },
        "agree": {
          "description": "The \"AGREED\" blocks.",
          "items": {
            "$ref": "#/$defs/Person"
          },
          "title": "Agree",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          },
          "title": "History",
          "type": "array"
        }
      },
      "required": [
        "title",
        "language"
      ],
      "title": "Document",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": false,
      "description": "A flag inside a bit field. ``bit`` is the offset from the field's least significant bit.",
      "properties": {
        "name": {
          "description": "Flag identifier: Latin letters, digits and _. Used in generated code and DBC. Required, unique within the frame.",
          "title": "Name",
          "type": "string"
        },
        "bit": {
          "description": "Flag offset from the least significant bit of the bit field: 0 is the field's LSB.",
          "minimum": 0,
          "title": "Bit",
          "type": "integer"
        },
        "bit_length": {
          "default": 1,
          "description": "Flag width in bits, 1 by default. A width above 1 makes a multi-bit value inside the field.",
          "minimum": 1,
          "title": "Bit Length",
          "type": "integer"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "values": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/EnumValue"
                  }
                ]
              },
              "type": "object",
              "propertyNames": {
                "pattern": "^(-?\\d+|0[xX][0-9a-fA-F]+)$"
              }
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value table (value → name) or the name of a table in value_tables.",
          "title": "Values"
        }
      },
      "required": [
        "name",
        "bit"
      ],
      "title": "Flag",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Frame identifier: Latin letters, digits and _. Used in generated code and DBC. Required, unique on the bus.",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable frame name, e.g. “Status”: the frame heading in documents and its label in the map tree. Optional; without it, the tree shows the identifier.",
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "canopen": {
          "anyOf": [
            {
              "enum": [
                "nmt",
                "sync",
                "emcy",
                "time",
                "pdo_tx1",
                "pdo_rx1",
                "pdo_tx2",
                "pdo_rx2",
                "pdo_tx3",
                "pdo_rx3",
                "pdo_tx4",
                "pdo_rx4",
                "sdo_tx",
                "sdo_rx",
                "heartbeat"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CANopen function of the frame (CiA 301): nmt, sync, emcy, time, pdo_tx1..4, pdo_rx1..4, sdo_tx, sdo_rx, heartbeat. Sets the base ID (e.g. PDO TX 1 = 0x180 + node_id), the default direction and the length of service frames. Empty: not a CANopen service frame, the ID is set explicitly. Only on CANopen buses. Formerly type (raw: empty).",
          "title": "Canopen"
        },
        "id": {
          "anyOf": [
            {
              "maximum": 536870911,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frame CAN ID: 11-bit (0x000..0x7FF) or 29-bit (up to 0x1FFFFFFF). Leave empty to compute it: for CANopen from the type and node_id, for J1939 from the PGN, priority and address.",
          "title": "Id"
        },
        "extended": {
          "default": false,
          "description": "Use a 29-bit (extended) identifier instead of an 11-bit one.",
          "title": "Extended",
          "type": "boolean"
        },
        "brs": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bit rate switch (BRS) of a CAN FD frame: the data field is sent at the data phase bit rate. Empty: as set on the bus. Written to DBC (the CANFD_BRS attribute).",
          "title": "Brs"
        },
        "pgn": {
          "anyOf": [
            {
              "maximum": 262143,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "J1939 parameter group number, 0..0x3FFFF. PF < 240 (0xF0) means PDU1, a destination-specific frame: the low byte of the PGN must be 0 and the destination is set separately. PF ≥ 240 means PDU2, broadcast.",
          "title": "Pgn"
        },
        "priority": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "J1939 priority 0..7: the top 3 bits of the ID. Lower values mean higher priority. Default 6.",
          "title": "Priority"
        },
        "destination": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Destination address for a J1939 PDU1 frame, 0..255. 0xFF means all nodes.",
          "title": "Destination"
        },
        "receivers": {
          "description": "Devices on this bus that receive the frame. The owner of an RX frame is a receiver even without this list. Used in documents, DBC and each device's \"Receives\" summary.",
          "items": {
            "type": "string"
          },
          "title": "Receivers",
          "type": "array"
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device on this bus that sends the frame when it is not the frame's owner: an RX frame (e.g. a node's RPDO sent by the master) or a bus frame (NMT, SYNC). Empty — the sender is not in the map. A frame sent by one of your devices is best described at the sender, with the receiving devices listed in \"Receivers\".",
          "title": "Sender"
        },
        "length": {
          "anyOf": [
            {
              "maximum": 1785,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frame data length in bytes: 0..8, for CAN FD up to 64 (12, 16, 20, 24, 32, 48, 64). Required except for CANopen service frames (NMT, SYNC, TIME, Heartbeat, SDO), whose length is set by CiA 301. Up to 1785 bytes on a J1939 bus, with the transport protocol. Formerly dlc: the DLC on the bus is the code of this length.",
          "title": "Length"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "tx",
                "rx"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "tx — the owning device sends the frame, rx — it receives it. If omitted: from the CANopen frame type (PDO TX is sent, etc.); a frame without a type whose sender is another device is rx, otherwise tx.",
          "title": "Direction"
        },
        "cycle_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cyclic transmission period in milliseconds.",
          "title": "Cycle Ms"
        },
        "trigger": {
          "anyOf": [
            {
              "enum": [
                "event",
                "on_request"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Non-cyclic transmission: event — on event, on_request — on request.",
          "title": "Trigger"
        },
        "timeout_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Receive timeout in milliseconds: when the frame has not arrived for this long, the receivers treat its data as lost. Usually a few periods, e.g. 3 × cycle_ms. In code: …_TIMEOUT_MS.",
          "title": "Timeout Ms"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        },
        "sdo": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SdoExchange"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdo"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A note or caveat: \"Note:\" in documents, after the description in DBC.",
          "title": "Comment"
        }
      },
      "required": [
        "name"
      ],
      "title": "Frame",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "github": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GitHub username of the change's author.",
          "title": "Github"
        },
        "changes": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/LocalizedText"
              }
            ]
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "version"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "InvalidRaw": {
      "additionalProperties": false,
      "description": "Raw values without a value, by meaning (J1939-71: \"not available\" and \"error indicator\").",
      "properties": {
        "not_available": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw values meaning “not available”: the sender has no value (e.g. 0xFF).",
          "title": "Not Available"
        },
        "error": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw values meaning “error”: the sender has a fault in this value (e.g. 0xFE).",
          "title": "Error"
        }
      },
