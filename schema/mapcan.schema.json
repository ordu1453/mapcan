{
  "$defs": {
    "Bus": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name for people, e.g. \"States\": the label in the map tree and the heading in documents.",
          "title": "Title"
        },
        "interface": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface"
        },
        "bitrate": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bitrate"
        },
        "protocol": {
          "description": "Protocol: canopen — IDs from the frame type and node_id, j1939 — from the PGN and address, can — explicit IDs.",
          "enum": [
            "canopen",
            "j1939",
            "can"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "fd": {
          "default": false,
          "title": "Fd",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "frames": {
          "description": "Broadcast frames without an owning device (NMT, SYNC, TIME).",
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "title": "Frames",
          "type": "array"
        },
        "devices": {
          "items": {
            "$ref": "#/$defs/Device"
          },
          "title": "Devices",
          "type": "array"
        }
      },
      "required": [
        "name",
        "protocol"
      ],
      "title": "Bus",
      "type": "object"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "short": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Device abbreviation, e.g. \"BMS\": in document tables and before the name in the tree.",
          "title": "Short"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name for people, e.g. \"States\": the label in the map tree and the heading in documents.",
          "title": "Title"
        },
        "node_id": {
          "anyOf": [
            {
              "maximum": 127,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CANopen: node address 1..127.",
          "title": "Node Id"
        },
        "address": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "J1939: source address 0..253.",
          "title": "Address"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "title": "Frames",
          "type": "array"
        }
      },
      "required": [
        "name"
      ],
      "title": "Device",
      "type": "object"
    },
    "Document": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            }
          ],
          "title": "Title"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "version": {
          "default": "0.1",
          "title": "Version",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "organization": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Organization"
        },
        "language": {
          "description": "Default document language: ISO 639-1 code (ru, en, de…).",
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        },
        "bit_numbering": {
          "const": "lsb0",
          "default": "lsb0",
          "description": "Bit numbering: lsb0 — bit 0 is the least significant bit of byte 0. The field states the convention explicitly and is shown in every document.",
          "title": "Bit Numbering",
          "type": "string"
        },
        "logo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Company logo: path to a PNG/JPG/SVG relative to the map file.",
          "title": "Logo"
        },
        "designation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document designation, e.g. \"АБВГ.468332.001 Д1\" (ESKD).",
          "title": "Designation"
        },
        "litera": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Document letter (ESKD), e.g. \"О1\".",
          "title": "Litera"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "City for the title page.",
          "title": "City"
        },
        "signatures": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signatures"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approve": {
          "anyOf": [
            {
              "$ref": "#/$defs/Person"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The \"APPROVED\" block of the title page."
        },
        "agree": {
          "description": "The \"AGREED\" blocks.",
          "items": {
            "$ref": "#/$defs/Person"
          },
          "title": "Agree",
          "type": "array"
        },
        "history": {
          "items": {
            "$ref": "#/$defs/HistoryEntry"
          },
          "title": "History",
          "type": "array"
        }
      },
      "required": [
        "title",
        "language"
      ],
      "title": "Document",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "Flag": {
      "additionalProperties": false,
      "description": "A flag inside a bit field. ``bit`` is the offset from the field's least significant bit.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "bit": {
          "minimum": 0,
          "title": "Bit",
          "type": "integer"
        },
        "bit_length": {
          "default": 1,
          "minimum": 1,
          "title": "Bit Length",
          "type": "integer"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "values": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/EnumValue"
                  }
                ]
              },
              "type": "object",
              "propertyNames": {
                "pattern": "^(-?\\d+|0[xX][0-9a-fA-F]+)$"
              }
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value table (value → name) or the name of a table in value_tables.",
          "title": "Values"
        }
      },
      "required": [
        "name",
        "bit"
      ],
      "title": "Flag",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Name for people, e.g. \"States\": the label in the map tree and the heading in documents.",
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "type": {
          "default": "raw",
          "enum": [
            "nmt",
            "sync",
            "emcy",
            "time",
            "pdo_tx1",
            "pdo_rx1",
            "pdo_tx2",
            "pdo_rx2",
            "pdo_tx3",
            "pdo_rx3",
            "pdo_tx4",
            "pdo_rx4",
            "sdo_tx",
            "sdo_rx",
            "heartbeat",
            "raw"
          ],
          "title": "Type",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maximum": 536870911,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Explicit CAN ID. For CANopen it is computed from node_id, for J1939 from the PGN.",
          "title": "Id"
        },
        "extended": {
          "default": false,
          "title": "Extended",
          "type": "boolean"
        },
        "pgn": {
          "anyOf": [
            {
              "maximum": 262143,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "J1939: parameter group number (PGN).",
          "title": "Pgn"
        },
        "priority": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "J1939: priority 0..7 (6 by default).",
          "title": "Priority"
        },
        "destination": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "J1939: destination address for PDU1 (0xFF, global, by default).",
          "title": "Destination"
        },
        "receivers": {
          "description": "Bus devices that receive the frame (names).",
          "items": {
            "type": "string"
          },
          "title": "Receivers",
          "type": "array"
        },
        "sender": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bus device that transmits the frame when it is not the frame's owner: for RX frames (e.g. a node's RPDO sent by the master) and bus frames (NMT, SYNC).",
          "title": "Sender"
        },
        "dlc": {
          "anyOf": [
            {
              "maximum": 64,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Data length, bytes. Required except for CANopen service frames (NMT, SYNC, TIME, Heartbeat, SDO), whose length is set by CiA 301.",
          "title": "Dlc"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "tx",
                "rx"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "cycle_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Cyclic transmission period, ms.",
          "title": "Cycle Ms"
        },
        "trigger": {
          "anyOf": [
            {
              "enum": [
                "event",
                "on_request"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Non-cyclic transmission: event — on event, on_request — on request.",
          "title": "Trigger"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        },
        "sdo": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/SdoExchange"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sdo"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A note or caveat: \"Note:\" in documents, after the description in DBC.",
          "title": "Comment"
        }
      },
      "required": [
        "name"
      ],
      "title": "Frame",
      "type": "object"
    },
    "HistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "version": {
          "title": "Version",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "github": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "GitHub username of the change's author.",
          "title": "Github"
        },
        "changes": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/LocalizedText"
              }
            ]
          },
          "title": "Changes",
          "type": "array"
        }
      },
      "required": [
        "version"
      ],
      "title": "HistoryEntry",
      "type": "object"
    },
    "LintRules": {
      "additionalProperties": false,
      "description": "Configurable style rules (checked as warnings).",
      "properties": {
        "signal_name": {
          "default": "snake_case",
          "enum": [
            "snake_case",
            "UPPER_SNAKE",
            "camelCase",
            "PascalCase",
            "any"
          ],
          "title": "Signal Name",
          "type": "string"
        },
        "frame_name": {
          "default": "snake_case",
          "enum": [
            "snake_case",
            "UPPER_SNAKE",
            "camelCase",
            "PascalCase",
            "any"
          ],
          "title": "Frame Name",
          "type": "string"
        },
        "device_name": {
          "default": "snake_case",
          "enum": [
            "snake_case",
            "UPPER_SNAKE",
            "camelCase",
            "PascalCase",
            "any"
          ],
          "title": "Device Name",
          "type": "string"
        },
        "value_name": {
          "default": "UPPER_SNAKE",
          "enum": [
            "snake_case",
            "UPPER_SNAKE",
            "camelCase",
            "PascalCase",
            "any"
          ],
          "title": "Value Name",
          "type": "string"
        },
        "disable": {
          "description": "Codes of the rules to disable.",
          "items": {
            "type": "string"
          },
          "title": "Disable",
          "type": "array"
        }
      },
      "title": "LintRules",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": true,
      "description": "Текст с переводами: ключ — код языка ISO 639-1 (ru, en, de…). Строка вместо объекта —\nтекст на языке документа.",
      "properties": {
        "ru": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ru"
        },
        "en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "En"
        }
      },
      "title": "LocalizedText",
      "type": "object"
    },
    "Person": {
      "additionalProperties": false,
      "description": "An official for the \"APPROVED\" / \"AGREED\" blocks.",
      "properties": {
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "name": {
          "default": "",
          "title": "Name",
          "type": "string"
        }
      },
      "title": "Person",
      "type": "object"
    },
    "SdoExchange": {
      "additionalProperties": false,
      "description": "One SDO transfer (expedited): command, index, subindex, value.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "command": {
          "description": "Command byte (CCS/SCS), e.g. 0x2B.",
          "maximum": 255,
          "minimum": 0,
          "title": "Command",
          "type": "integer"
        },
        "index": {
          "maximum": 65535,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "subindex": {
          "default": 0,
          "maximum": 255,
          "minimum": 0,
          "title": "Subindex",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdoValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "command",
        "index"
      ],
      "title": "SdoExchange",
      "type": "object"
    },
    "SdoValue": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "encoding": {
          "description": "Value encoding: enum, scaled, raw.",
          "enum": [
            "enum",
            "scaled",
            "raw"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "bit_length": {
          "enum": [
            8,
            16,
            24,
            32
          ],
          "title": "Bit Length",
          "type": "integer"
        },
        "signed": {
          "default": false,
          "title": "Signed",
          "type": "boolean"
        },
        "factor": {
          "default": 1.0,
          "title": "Factor",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "title": "Offset",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
