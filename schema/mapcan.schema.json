    "Signal": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Signal identifier: Latin letters, digits and _. Used in generated code and DBC. Required, unique within the frame.",
          "title": "Name",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable signal name, e.g. “Battery voltage”: its label in the map tree. Optional; without it, the tree shows the identifier.",
          "title": "Title"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What it is and what for: shown in documents, comments of generated code and DBC.",
          "title": "Description"
        },
        "encoding": {
          "description": "How the value is interpreted. enum — a value table; flag — a single yes/no bit; bitfield — a set of flags; scaled — a scaled value: raw × factor + offset; raw — an integer as is; float — IEEE 754; bytes — a byte array.",
          "enum": [
            "enum",
            "flag",
            "bitfield",
            "scaled",
            "raw",
            "bytes",
            "float"
          ],
          "title": "Encoding",
          "type": "string"
        },
        "start_bit": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Position of the signal's least significant bit (LSB) in the frame, counting from 0. Bit N is in byte N div 8 at position N mod 8.",
          "title": "Start Bit"
        },
        "bit_length": {
          "anyOf": [
            {
              "maximum": 14280,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Signal width in bits: 1..64; longer only for a byte array (encoding: bytes).",
          "title": "Bit Length"
        },
        "byte": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "First byte of the signal.",
          "title": "Byte"
        },
        "bit": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bit offset within the byte.",
          "title": "Bit"
        },
        "byte_length": {
          "anyOf": [
            {
              "maximum": 1785,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Signal length in bytes, instead of bit_length.",
          "title": "Byte Length"
        },
        "byte_order": {
          "default": "little_endian",
          "description": "Byte order of a multi-byte signal. little-endian (Intel): least significant byte first, typical for CANopen and J1939. big-endian (Motorola): most significant byte first.",
          "enum": [
            "little_endian",
            "big_endian"
          ],
          "title": "Byte Order",
          "type": "string"
        },
        "representation": {
          "default": "unsigned",
          "description": "How the raw value is read as a number. unsigned — no negative values (default). twos_complement — the usual signed integer (−1 = all ones). ones_complement — a negative value is its magnitude with all bits inverted (−1 = 1…10). sign_magnitude — the top bit is the sign, the rest the magnitude (−1 = 10…01). Generated C and Python code use this representation; DBC stores two's complement only, so the export warns about the other two. Formerly signed and signed_code.",
          "enum": [
            "unsigned",
            "twos_complement",
            "ones_complement",
            "sign_magnitude"
          ],
          "title": "Representation",
          "type": "string"
        },
        "values": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/EnumValue"
                  }
                ]
              },
              "type": "object",
              "propertyNames": {
                "pattern": "^(-?\\d+|0[xX][0-9a-fA-F]+)$"
              }
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value table (value → name) or the name of a table in value_tables.",
          "title": "Values"
        },
        "flags": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Flag"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flags"
        },
        "factor": {
          "default": 1.0,
          "description": "Multiplier: physical value = raw × factor + offset. E.g. 0.1 for voltage in 0.1 V steps.",
          "title": "Factor",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "description": "Offset: physical value = raw × factor + offset. E.g. −40 for temperature.",
          "title": "Offset",
          "type": "number"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unit of the physical quantity: a standard unit or your own text. Standard units appear in documents in the document language (V ↔ В).",
          "title": "Unit"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allowed minimum in physical units. Leave empty to use the limit of the signal width.",
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Allowed maximum in physical units. Leave empty to use the limit of the signal width.",
          "title": "Max"
        },
        "value_format": {
          "default": "dec",
          "description": "How enum table values are shown in documents: decimal or hex.",
          "enum": [
            "dec",
            "hex"
          ],
          "title": "Value Format",
          "type": "string"
        },
        "multiplexer": {
          "default": false,
          "description": "Multiplexer selector signal. Multiplexing lets one frame carry different sets of signals: the selector value tells which signals the frame currently contains. A frame can have only one selector.",
          "title": "Multiplexer",
          "type": "boolean"
        },
        "mux": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Selector values for which this signal is in the frame, e.g. 0 or 1, 2. Leave empty if the signal is always present. Requires a selector signal in the frame.",
          "title": "Mux"
        },
        "initial": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Value after power-up or before the first message is received, in physical units. In C: …_INITIAL_RAW; in DBC: GenSigStartValue.",
          "title": "Initial"
        },
        "invalid_raw": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "array"
            },
            {
              "$ref": "#/$defs/InvalidRaw"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Raw values that carry no value: one value, a list, ranges such as \"0xFF00..0xFFFF\", or by meaning: {not_available: …, error: …}. A plain value or list means “not available”. In C: …_is_not_available() and …_is_error(). Formerly invalid.",
          "title": "Invalid Raw"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A note or caveat: \"Note:\" in documents, after the description in DBC.",
          "title": "Comment"
        },
        "spn": {
          "anyOf": [
            {
              "maximum": 524287,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "J1939: suspect parameter number (SPN) per SAE J1939-71.",
          "title": "Spn"
        },
        "index": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CANopen: index of the dictionary object mapped into the PDO.",
          "title": "Index"
        },
        "subindex": {
          "anyOf": [
            {
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CANopen: subindex of the dictionary object (0 by default).",
          "title": "Subindex"
        }
      },
      "required": [
        "name",
        "encoding"
      ],
      "title": "Signal",
      "type": "object"
    },
    "Signatures": {
